# ========================================================
# CARDBACK PRODUCTION & ENVIRONMENT CONFIGURATION
# ========================================================

# Servidor i Entorn
NODE_ENV=production
PORT=3000

# Base de Dades PostgreSQL (Neon, Supabase o Cloud SQL)
# Ex: postgresql://username:password@ep-cool-sample.eu-central-1.aws.neon.tech/cardback?sslmode=require
DATABASE_URL=

# Seguretat de Sessions i JWT (Imprescindible mínim 32 caràcters en producció)
# Pots generar-ne un de fort amb la comanda: openssl rand -hex 32
JWT_SECRET=super_strong_random_secret_cardback_production_change_this_key_min_32_chars

# Servei de Correu Transaccional (Resend per a restablir contrasenyes)
# Obtinguda a https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=suport@teudomini.com

# URL Base Pública de l'Aplicació (per a enllaços en correus electrònics)
# Ex: https://cardback.app
APP_BASE_URL=https://your-domain.com

# Intel·ligència Artificial (Google Gemini Vision per reconeixement de figures i blísters)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Emmagatzematge d'Imatges al Núvol Tipus Discogs (Opcional)
# Opció A: ImgBB (100% Gratuït, SENSE TARGETA NI PAYPAL). Obtinguda a https://api.imgbb.com
IMGBB_API_KEY=

# Opció B: Cloudflare R2 / AWS S3 / Backblaze B2 (requereix targeta/PayPal en el registre de Cloudflare)
# Si cap d'aquestes variables està configurada, l'aplicació guarda les fotos directament al disc local (/uploads/)
R2_BUCKET_NAME=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_DOMAIN=https://pub-<id>.r2.dev
